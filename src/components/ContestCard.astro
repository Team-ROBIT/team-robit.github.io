---
// 참여 대회 목록의 카드. href가 없으면 클릭 불가(상세 페이지 준비 중) 상태로 표시한다.
//   cutout: 배경이 투명한 로봇 사진일 때(밝은 배경 위에 얹는다)
//   bare:   이미지에 이미 제목이 들어 있어 제목 겹쳐 쓰기를 생략할 때
import { Image } from 'astro:assets';

interface Props {
    imagePath: any;
    title: string;
    href?: string;
    cutout?: boolean;
    bare?: boolean;
}
const { imagePath, title, href, cutout = false, bare = false } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class:list={['cc', !href && 'off', cutout && 'cut', bare && 'bare']} aria-label={title}>
    <Image src={imagePath} alt={bare ? title : ''} width={720} loading="lazy" />
    {!bare && <span class="ct">{title}</span>}
    {href ? <span class="go">→</span> : <span class="soon">상세 페이지 준비 중</span>}
</Tag>
