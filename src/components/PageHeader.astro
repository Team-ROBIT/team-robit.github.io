---
// 하위 페이지 상단 제목 카드: 분류 라벨, 큰 제목, 영문 부제, 칩, 커버(누끼 로봇 또는 사진)
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  kicker?: string;
  title: string;
  subtitle?: string;
  chips?: string[];
  highlight?: string;
  cover?: ImageMetadata;
  coverKind?: 'cutout' | 'photo';
}
const { kicker, title, subtitle, chips = [], highlight, cover, coverKind = 'photo' } = Astro.props;
---

<header class:list={['title', !cover && 'one']}>
  <div>
    <div class="lbl"><i></i>{kicker}{subtitle && <> · {subtitle}</>}</div>
    <h1>{title}</h1>
    {(chips.length > 0 || highlight) && (
      <div class="badges">
        {highlight && <span class="hl">{highlight}</span>}
        {chips.map((c) => <span>{c}</span>)}
      </div>
    )}
  </div>
  {cover && (
    <div class:list={['tfig', coverKind === 'photo' && 'photo']}>
      <Image src={cover} alt="" widths={[480, 760]} sizes="(max-width: 1000px) 80vw, 300px" loading="eager" />
    </div>
  )}
</header>
