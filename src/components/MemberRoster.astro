---
// 기수별 명단: 기수 선택 띠 + 팀 사진 + 단원 카드 + 주장 카드
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import generations from '../data/generations.json';

interface Member {
    name: string;
    label?: string; // 예: 18기(23)
    part?: string; // 예: Software Engineer
    captain?: boolean;
    github?: string;
    note?: string;
    photo?: ImageMetadata;
    interview?: string;
    profile?: string;
}
interface TeamGroup {
    team: string;
    photos?: ImageMetadata[];
    members: Member[];
}
interface Captain {
    name: string;
    photos?: ImageMetadata[];
    link?: string;
    heading?: string;
}
interface Props {
    teams: TeamGroup[];
    captain?: Captain;
}
const { teams, captain } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '').split('/').pop();
const years: Record<number, string> = { 1: '2006', 2: '2007', 3: '2008', 4: '2009', 5: '2010', 6: '2011', 7: '2012', 8: '2013', 9: '2014', 10: '2014–15', 11: '2015–16', 12: '2017', 13: '2018', 14: '2019', 15: '2020', 16: '2021', 17: '2022', 18: '2023', 19: '2024', 20: '2026' };
---

<div class="gens">
    {generations.map((g) => (
        <a class:list={['gn', g.slug === current && 'on']} href={`/members/${g.slug}`}>
            <b>{g.num}기</b><span>{years[g.num]}</span>
        </a>
    ))}
</div>

{teams.map((group) => (
    <section class="team">
        <h3>{group.team} · {group.members.length}명</h3>
        {group.photos && group.photos.length > 0 && (
            <div class:list={['tps', group.photos.length > 1 && 'multi']}>
                {group.photos.map((p) => (
                    <div class="tp"><Image src={p} alt={`${group.team} 사진`} width={1100} loading="lazy" /></div>
                ))}
            </div>
        )}
        <div class="mg">
            {group.members.map((m) => (
                <div class="mc">
                    {m.captain && <span class="cap">CAPTAIN</span>}
                    {m.photo ? (
                        <div class="av"><Image src={m.photo} alt={m.name} width={192} height={192} loading="lazy" /></div>
                    ) : (
                        <div class="av empty">{m.name.slice(0, 1)}</div>
                    )}
                    <b>{m.profile ? <a href={m.profile}>{m.name}</a> : m.name}</b>
                    <em>{[m.part, m.note].filter(Boolean).join(' · ') || ' '}</em>
                    {m.label && <small class="lb">{m.label}</small>}
                    <div class="links">
                        {m.github && <a class="gh" href={`https://github.com/${m.github}`} target="_blank" rel="noopener">GitHub ↗</a>}
                        {m.interview && <a class="gh" href={m.interview} target="_blank" rel="noopener">인터뷰 ↗</a>}
                    </div>
                </div>
            ))}
        </div>
    </section>
))}

{captain && captain.name && (
    <section class="team">
        <h3>{captain.heading ?? 'Captain'}</h3>
        <div class="capbox">
            {captain.photos && captain.photos.length > 0 && (
                <div class="capph">
                    {captain.photos.map((p) => <Image src={p} alt={captain.name} width={640} loading="lazy" />)}
                </div>
            )}
            <div>
                <small>{captain.heading ?? 'Captain'}</small>
                <h4>{captain.link ? <a href={captain.link} target={captain.link.startsWith("http") ? "_blank" : undefined} rel="noopener">{captain.name}</a> : captain.name}</h4>
            </div>
        </div>
    </section>
)}
