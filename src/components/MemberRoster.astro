---
// src/components/MemberRoster.astro
// 기수별 멤버 명단을 팀별 카드 그리드로 보여주는 컴포넌트.
// 원본 아카이브(구글 사이트)의 팀 사진 / 멤버 프로필 사진 / 인터뷰 링크 / 주장 사진을 함께 보여줍니다.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Member {
    name: string;
    label?: string; // 예: 17th(22) — 기수(입단 연도)
    part?: string; // 예: Software Engineer, Hardware Design
    captain?: boolean;
    github?: string;
    note?: string; // 기타 정보
    photo?: ImageMetadata; // 프로필 사진
    interview?: string; // 인터뷰 영상 링크
    profile?: string; // 개인 프로필 페이지
}
interface TeamGroup {
    team: string;
    photos?: ImageMetadata[]; // 팀 사진
    members: Member[];
}
interface Captain {
    name: string;
    photos?: ImageMetadata[];
    link?: string;
    heading?: string; // 예: RO:BIT 17th Captain
}
interface Props {
    teams: TeamGroup[];
    captain?: Captain;
}
const { teams, captain } = Astro.props;
---

<div class="not-prose space-y-10">
    {teams.map((group) => (
        <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-3">
                {group.team} <span class="text-zinc-400 dark:text-zinc-600 font-normal">· {group.members.length}명</span>
            </h3>
            {group.photos && group.photos.length > 0 && (
                <div class:list={['grid grid-cols-1 gap-3 mb-4', group.photos.length > 1 && 'sm:grid-cols-2']}>
                    {group.photos.map((p) => (
                        <Image src={p} alt={`${group.team} 사진`} width={720} class="w-full rounded-xl border border-zinc-200 dark:border-zinc-800" />
                    ))}
                </div>
            )}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                {group.members.map((m) => (
                    <div class="flex items-center justify-between gap-3 rounded-lg border border-zinc-200 dark:border-zinc-800 px-4 py-3">
                        <div class="flex items-center gap-3 min-w-0">
                            {m.photo && (
                                <Image src={m.photo} alt={m.name} width={112} height={112} class="w-14 h-14 rounded-full object-cover shrink-0" />
                            )}
                            <div class="min-w-0">
                                <div class="flex items-center gap-1.5">
                                    {m.profile ? (
                                        <a href={m.profile} class="font-bold truncate hover:underline">{m.name}</a>
                                    ) : (
                                        <span class="font-bold truncate">{m.name}</span>
                                    )}
                                    {m.captain && (
                                        <span title="Captain" class="text-brand dark:text-brand-light shrink-0">★</span>
                                    )}
                                </div>
                                {(m.label || m.part || m.note) && (
                                    <p class="text-xs text-zinc-500 dark:text-zinc-400 truncate">
                                        {[m.label, m.captain ? 'Captain' : m.part, m.note].filter(Boolean).join(' · ')}
                                    </p>
                                )}
                            </div>
                        </div>
                        <div class="flex flex-col items-end gap-0.5 shrink-0">
                            {m.github && (
                                <a
                                    href={`https://github.com/${m.github}`}
                                    target="_blank"
                                    rel="noopener"
                                    class="text-xs font-semibold text-brand dark:text-brand-light hover:underline"
                                >
                                    GitHub
                                </a>
                            )}
                            {m.interview && (
                                <a
                                    href={m.interview}
                                    target="_blank"
                                    rel="noopener"
                                    class="text-xs font-semibold text-brand dark:text-brand-light hover:underline"
                                >
                                    인터뷰
                                </a>
                            )}
                        </div>
                    </div>
                ))}
            </div>
        </div>
    ))}

    {captain && captain.name && (
        <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-3">
                {captain.heading ?? 'Captain'}
            </h3>
            {captain.photos && captain.photos.length > 0 && (
                <div class:list={['grid grid-cols-1 gap-3 mb-3', captain.photos.length > 1 && 'sm:grid-cols-2']}>
                    {captain.photos.map((p) => (
                        <Image src={p} alt={captain.name} width={720} class="w-full rounded-xl border border-zinc-200 dark:border-zinc-800" />
                    ))}
                </div>
            )}
            <p class="font-bold">
                {captain.link ? (
                    <a href={captain.link} target="_blank" rel="noopener" class="hover:underline">{captain.name}</a>
                ) : (
                    captain.name
                )}
            </p>
        </div>
    )}
</div>
