---
// 상단 바 + 호버 메가메뉴 + 모바일 메뉴
import { Image, getImage } from 'astro:assets';
import logo from '../assets/robit_logo_kw.png';
import { sections, contactHref, sectionOf } from '../data/nav';

const current = sectionOf(Astro.url.pathname.replace(/^\//, '')).key;

// 메가메뉴에 쓸 이미지는 작게 최적화해서 JSON으로 넘긴다.
const mega: Record<string, unknown> = {};
for (const s of sections) {
  mega[s.key] = {
    h: s.en,
    t: s.label,
    p: s.desc,
    list: await Promise.all(
      s.items.map(async (it) => ({
        label: it.label,
        meta: it.meta ?? '',
        href: it.href,
        img: (await getImage({ src: it.image, width: 720, format: 'webp' })).src,
      })),
    ),
  };
}
---

<div class="prog" id="prog"></div>
<header class="site">
  <div class="bar">
    <div class="wrap">
      <a class="logo" href="/" aria-label="ROːBIT Archive 홈"><Image src={logo} alt="RO:BIT" width={220} loading="eager" /></a>
      <nav class="menu" id="menu" aria-label="주요 메뉴">
        {sections.map((s) => (
          <a href={s.href} data-m={s.key} class={s.key === current ? 'cur' : ''}>{s.label}</a>
        ))}
        <a href={contactHref} class={current === 'contact' ? 'cur' : ''}>Contact</a>
      </nav>
      <div class="r">
        <a class="cta" href={contactHref}>문의하기</a>
        <button class="burger" id="burger" aria-label="메뉴 열기" aria-expanded="false"><i></i><i></i><i></i></button>
      </div>
    </div>
  </div>
  <div class="mega" id="mega" aria-hidden="true">
    <div class="wrap">
      <div class="col"><h6 id="mh">LIST</h6><div id="ml"></div></div>
      <div class="desc"><h3 id="mt"></h3><p id="mp"></p></div>
      <div class="feat" id="mf" data-t=""></div>
    </div>
  </div>
</header>
<div class="scrim" id="scrim"></div>

<div class="drawer" id="drawer">
  {sections.map((s, i) => (
    <details open={i === 1}>
      <summary>{s.label}</summary>
      {s.items.map((it) => (
        <a href={it.href}>{it.label}<em>{it.meta}</em></a>
      ))}
    </details>
  ))}
  <a class="solo" href={contactHref}>Contact</a>
</div>

<script type="application/json" id="mega-data" set:html={JSON.stringify(mega)} />
