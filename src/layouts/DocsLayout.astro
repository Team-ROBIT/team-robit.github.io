---
// 하위 페이지 공통 레이아웃: 페이지 헤더 + (h2가 둘 이상이면) 고정 탭 + 본문
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

interface Props {
  title: string;
  description?: string;
  kicker?: string;
  crumb?: string;
  subtitle?: string;
  chips?: string[];
  highlight?: string;
  cover?: ImageMetadata;
  coverKind?: 'cutout' | 'photo';
  headings?: { depth: number; slug: string; text: string }[];
  /** 데이터 기반 템플릿 페이지처럼 .doc 스타일을 쓰지 않고 자체 레이아웃을 쓸 때 */
  bare?: boolean;
  wide?: boolean;
  tabs?: { href: string; label: string }[];
}
const { title, description, kicker, crumb, subtitle, chips, highlight, cover, coverKind, headings = [], bare = false, wide = false } = Astro.props;
const tabs =
  Astro.props.tabs ??
  headings.filter((h) => h.depth === 2).map((h) => ({ href: `#${h.slug}`, label: h.text }));
---

<BaseLayout title={title} description={description}>
  <PageHeader {kicker} {crumb} {title} {subtitle} {chips} {highlight} {cover} {coverKind} />
  {tabs.length >= 2 && (
    <div class="tabs">
      <div class="wrap">
        {tabs.map((t, i) => <a class={i === 0 ? 'on' : ''} href={t.href}>{t.label}</a>)}
      </div>
    </div>
  )}
  <div class:list={['page', (wide || bare) && 'wide']}>
    {bare ? <slot /> : <article class="doc"><slot /></article>}
  </div>
</BaseLayout>
