---
// 하위 페이지 공통 레이아웃: 제목 카드 + 본문 + 오른쪽 "ON THIS PAGE" 목차
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

interface Props {
  title: string;
  description?: string;
  kicker?: string;
  subtitle?: string;
  chips?: string[];
  highlight?: string;
  cover?: ImageMetadata;
  coverKind?: 'cutout' | 'photo';
  headings?: { depth: number; slug: string; text: string }[];
  /** 데이터 기반 템플릿 페이지처럼 .doc 스타일을 쓰지 않고 자체 레이아웃을 쓸 때 */
  bare?: boolean;
  wide?: boolean;
  tabs?: { href: string; label: string }[];
}
const { title, description, kicker, subtitle, chips, highlight, cover, coverKind, headings = [], bare = false, wide = false } = Astro.props;
const toc =
  Astro.props.tabs ??
  headings.filter((h) => h.depth === 2).map((h) => ({ href: `#${h.slug}`, label: h.text }));
const showToc = toc.length >= 2;
---

<BaseLayout title={title} description={description}>
  <div class:list={['dl', !showToc && 'notoc', (wide || bare) && 'wide']}>
    <div class="dl-main">
      <PageHeader {kicker} {title} {subtitle} {chips} {highlight} {cover} {coverKind} />
      {bare ? <slot /> : <article class="doc"><slot /></article>}
    </div>
    {showToc && (
      <aside class="toc" aria-label="이 페이지의 목차">
        <p>ON THIS PAGE</p>
        {toc.map((t, i) => <a class={i === 0 ? 'on' : ''} href={t.href}>{t.label}</a>)}
      </aside>
    )}
  </div>
</BaseLayout>
