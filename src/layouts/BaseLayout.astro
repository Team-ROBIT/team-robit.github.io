---
// 모든 페이지의 공통 틀(설계도 레이아웃): <head>, 왼쪽 사이드바, 상단 바, 푸터, 공통 스크립트
import SideNav from '../components/SideNav.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = '광운대학교 로봇게임단 로빛(ROːBIT)의 대회, 행사, 로봇, 단원 기록 아카이브' } = Astro.props;
const fullTitle = title === 'ROːBIT Archive' ? title : `${title} | ROːBIT Archive`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#7a2233" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <noscript><style>.rv{opacity:1!important;transform:none!important}</style></noscript>
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class="prog" id="prog"></div>
    <SideNav />
    <main>
      <TopBar />
      <slot />
      <Footer />
    </main>
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
