---
// 홈(설계도 레이아웃): 히어로(로봇 도면) · 섹션 카드 · 연표 · 최근 수상
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { stats, latest, milestones } from '../data/home';
import tank from '../assets/assets_contest/defense-robot-003.webp';
import tank1 from '../assets/assets_contest/defense-robot-001.webp';
import podium from '../assets/assets_awards/awards-2018-004.webp';
import team18 from '../assets/assets_members/members-18-team-1.webp';
import crowd from '../assets/assets_events/event-001.webp';
import invite from '../assets/assets_events/event-046.webp';

const first = milestones[0].year;
const last = milestones[milestones.length - 1].year;
const pos = (y: number) => ((y - first) / (last - first)) * 100;
const ticks = [2006, 2011, 2016, 2021, 2026];
---

<BaseLayout title="ROːBIT Archive">
  <div class="home">
    <section class="hero" id="hero">
      <div class="glow" id="glow"></div>
      <div>
        <span class="chip"><i></i>ARCHIVE · 2006 — 2026</span>
        <h1>로빛의 모든 기록,<br /><span>한 곳에서.</span></h1>
        <p>광운대학교 로봇게임단 로빛이 20년간 만든 로봇과 참가한 대회, 함께한 사람들의 자료를 찾기 쉽게 정리한 아카이브입니다.</p>
        <div class="act">
          <a class="btn p" href="/contest/participation">기록 탐색하기 <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 8h11M9 3.5 13.5 8 9 12.5"></path></svg></a>
          <a class="btn s" href="/contest/awards">수상 내역</a>
        </div>
        <div class="mini">{stats.map((s) => <div><b>{s.n}</b>{s.label}</div>)}</div>
      </div>
      <div class="fig">
        <Image class="r" src={tank} alt="KUBO 국방로봇" width={640} loading="eager" />
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path d="M64 30 L84 14"></path><path d="M33 62 L12 80"></path><path d="M52 66 L58 90"></path><path d="M40 40 L16 26"></path>
        </svg>
        <span class="dot" style="left:64%;top:30%"></span><span class="lab" style="left:76%;top:6%;animation-delay:1s"><b>01</b>매니퓰레이터</span>
        <span class="dot" style="left:33%;top:62%"></span><span class="lab" style="left:-2%;top:80%;animation-delay:1.2s"><b>02</b>플리퍼 Semi-Auto</span>
        <span class="dot" style="left:52%;top:66%"></span><span class="lab" style="left:46%;top:90%;animation-delay:1.4s"><b>03</b>하모닉 기어 + BLDC</span>
        <span class="dot" style="left:40%;top:40%"></span><span class="lab" style="left:2%;top:20%;animation-delay:1.6s"><b>04</b>2D LiDAR · SLAM</span>
      </div>
    </section>

    <section class="sec rv">
      <div class="sh"><div><small>01 / SECTIONS</small><h2>섹션별로 보기</h2></div><a href="/contest/participation">전체 보기 →</a></div>
      <div class="cards">
        <a class="hc w" href="/contest/participation"><div class="in"><div class="ph"><Image src={podium} alt="" width={900} loading="lazy" /></div><div class="tx"><div class="ix"><span>03 · CONTEST</span><em>10 pages</em></div><h3>대회</h3><p>RoboCup, SRC·IRC, 국방·극한로봇경진대회 등 국내외 대회 참가 기록</p></div></div></a>
        <a class="hc w" href="/members/roster"><div class="in"><div class="ph"><Image src={team18} alt="" width={900} loading="lazy" /></div><div class="tx"><div class="ix"><span>08 · PEOPLE</span><em>20 generations</em></div><h3>단원</h3><p>1기부터 20기까지, 팀 사진과 주장·팀장, 파트별 단원</p></div></div></a>
        <a class="hc" href="/robots/list"><div class="in"><div class="ph cutph"><Image src={tank1} alt="" width={560} loading="lazy" /></div><div class="tx"><div class="ix"><span>07 · ROBOTS</span><em>57</em></div><h3>로봇</h3><p>역대 개발 로봇과 제원</p></div></div></a>
        <a class="hc" href="/events/participation"><div class="in"><div class="ph"><Image src={crowd} alt="" width={640} loading="lazy" /></div><div class="tx"><div class="ix"><span>05 · EVENTS</span><em>16</em></div><h3>행사</h3><p>전시·체험 행사 기록</p></div></div></a>
        <a class="hc" href="/articles/press"><div class="in"><div class="ph"><Image src={invite} alt="" width={640} loading="lazy" /></div><div class="tx"><div class="ix"><span>06 · ARTICLES</span><em>74</em></div><h3>기사 · 방송</h3><p>기사 스캔과 방송 출연</p></div></div></a>
      </div>
    </section>

    <section class="sec rv">
      <div class="sh"><div><small>02 / TIMELINE</small><h2>스무 해의 흐름</h2></div><a href="/overview/history">History &amp; Archive →</a></div>
      <div class="tlb">
        <div class="big"><b id="tlb">{first}</b><span id="tls">{milestones[0].title}</span></div>
        <div class="rail" id="rail" data-m={JSON.stringify(milestones.map((m) => ({ y: m.year, t: m.title, x: pos(m.year) })))}><div class="fill" id="fill"></div></div>
        <div class="yl">{ticks.map((y) => <span>{y}</span>)}</div>
      </div>
    </section>

    <section class="sec rv">
      <div class="sh"><div><small>03 / LATEST</small><h2>최근 수상</h2></div><a href="/contest/awards">수상 내역 전체 →</a></div>
      <div class="tb">
        <div class="tr hd"><span>YEAR</span><span>COMPETITION</span><span>AWARD</span><span style="justify-self:end">RANK</span></div>
        {latest.map((r) => (
          <a class="tr" href={r.href}>
            <span class="d">{r.year}</span><span class="n">{r.name}</span><span class="o">{r.org}</span>
            <span class:list={['tag', r.gold && 'g']}>{r.rank}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
