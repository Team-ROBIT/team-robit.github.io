---
// src/pages/[...slug].astro — src/content/archive 의 모든 문서를 페이지로 만든다.
import { getCollection } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import AwardsView from '../components/AwardsView.astro';
import EventsView from '../components/EventsView.astro';
import RobotsView from '../components/RobotsView.astro';
import GenerationGrid from '../components/GenerationGrid.astro';
import { sectionOf } from '../data/nav';

export async function getStaticPaths() {
    const docs = await getCollection('archive');
    return docs.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const d = entry.data;
const sec = sectionOf(entry.slug);
const template = d.template;
const isData = template !== 'doc';

// 데이터 템플릿 페이지의 탭
const tabsByTemplate: Record<string, { href: string; label: string }[]> = {
    awards: [
        { href: '#y2026', label: '2026 — 2022' },
        { href: '#y2021', label: '2021 — 2015' },
        { href: '#y2014', label: '2014 — 2007' },
        { href: '#y2006', label: '2006' },
    ],
    events: [],
    robots: [],
    roster: [],
};
---

<DocsLayout
    title={d.title}
    description={d.description}
    kicker={sec.kicker}
    subtitle={d.subtitle}
    chips={d.chips}
    highlight={d.highlight}
    cover={d.cover}
    coverKind={d.coverKind}
    headings={headings}
    bare={isData}
    tabs={isData ? tabsByTemplate[template] : undefined}
>
    {isData && <div class="doc intro-doc"><Content /></div>}
    {template === 'awards' && <AwardsView />}
    {template === 'events' && <EventsView />}
    {template === 'robots' && <RobotsView />}
    {template === 'roster' && <GenerationGrid />}
    {!isData && <Content />}
</DocsLayout>
